# OpenRouter (OpenAI-compatible API). Free models work: https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-v1-xxx
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Optional: Groq free tier, used as the last fallback (another provider). Without it the agent runs on OpenRouter only.
# GROQ_API_KEY=gsk_xxx

# Optional: models (defaults in src/emporio_agent/config.py). "groq:" prefix = Groq.
# MODEL=nvidia/nemotron-3.5-super-vl:free
# FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,groq:openai/gpt-oss-120b

# Optional: assistant's name
# ASSISTANT_NAME=Clave

# Optional: override the store's "today" (YYYY-MM-DD or ISO datetime). Default: real clock, America/Campo_Grande.
# STORE_TODAY=2026-03-25T10:00

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=lsv2_xxx
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=emporio-agent
